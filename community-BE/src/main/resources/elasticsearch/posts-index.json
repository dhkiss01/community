{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "char_filter": {
        "remove_space": {
          "type": "pattern_replace",
          "pattern": "\\s+",
          "replacement": ""
        }
      },
      "tokenizer": {
        "nori_tokenizer_mixed": {
          "type": "nori_tokenizer",
          "decompound_mode": "mixed"
        }
      },
      "analyzer": {
        "search_analyzer": {
          "type": "custom",
          "char_filter": [
            "remove_space"
          ],
          "tokenizer": "nori_tokenizer_mixed",
          "filter": [
            "nori_pos",
            "lowercase"
          ]
        }
      },
      "filter": {
        "nori_pos": {
          "type": "nori_part_of_speech"
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id": {
        "type": "long"
      },
      "title": {
        "type": "text",
        "analyzer": "search_analyzer"
      },
      "content": {
        "type": "text",
        "analyzer": "search_analyzer"
      },
      "createdAt": {
        "type": "date"
      },
      "category": {
        "type": "keyword"
      }
    }
  }
}
